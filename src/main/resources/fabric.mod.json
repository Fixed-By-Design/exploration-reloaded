{
    "schemaVersion": 1,
    "id": "exploration-reloaded",
    "version": "${version}",
    "name": "Exploration Reloaded",
    "description": "Exploration maps, Map Book, travel mobs, fishing, sniffer loot, and traversal tweaks extracted from Fixed Minecraft.",
    "authors": [
        "Aqu1tain"
    ],
    "contributors": [
        "green_jab"
    ],
    "contact": {
        "sources": "https://github.com/Aqu1tain/exploration-reloaded"
    },
    "license": "LGPL-3.0-only",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.akitain.explorationreloaded.ExplorationReloaded"
        ],
        "client": [
            "com.akitain.explorationreloaded.ExplorationReloadedClient"
        ]
    },
    "mixins": [
        "exploration-reloaded.mixins.json",
        {
            "config": "exploration-reloaded.goat.client.mixins.json",
            "environment": "client"
        },
        {
            "config": "exploration-reloaded.client.mixins.json",
            "environment": "client"
        },
        {
            "config": "exploration-reloaded.flight.client.mixins.json",
            "environment": "client"
        }
    ],
    "accessWidener": "exploration-reloaded.accesswidener",
    "depends": {
        "fabricloader": ">=0.19.2",
        "minecraft": "26.1.2",
        "java": ">=25",
        "fabric-api": "*"
    }
}
